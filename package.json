{
  "name": "@lvxiaoxin/copilot-sync",
  "version": "0.2.3",
  "description": "Cross-platform CLI to sync GitHub Copilot config and session history across devboxes via a GitHub repo.",
  "type": "module",
  "bin": {
    "copilot-sync": "bin/copilot-sync.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/copilot-sync.js",
    "prepublishOnly": "node -e \"['bin/copilot-sync.js'].forEach(f=>require('node:child_process').execFileSync(process.execPath,['--check',f],{stdio:'inherit'}))\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvxiaoxin/copilot-sync.git"
  },
  "homepage": "https://github.com/lvxiaoxin/copilot-sync#readme",
  "bugs": {
    "url": "https://github.com/lvxiaoxin/copilot-sync/issues"
  },
  "author": "lvxiaoxin",
  "keywords": [
    "sync",
    "copilot",
    "mcp",
    "skills",
    "cli",
    "cross-platform"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0"
  }
}
