{
  "name": "@lvxiaoxin/agent-sync",
  "version": "0.1.2",
  "description": "Cross-platform CLI to sync AI agent config artifacts (Copilot, Claude, Codex) across devboxes via a GitHub repo.",
  "type": "module",
  "bin": {
    "agent-sync": "bin/agent-sync.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/agent-sync.js",
    "prepublishOnly": "node -e \"['bin/agent-sync.js'].forEach(f=>require('node:child_process').execFileSync(process.execPath,['--check',f],{stdio:'inherit'}))\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvxiaoxin/agent-sync.git"
  },
  "homepage": "https://github.com/lvxiaoxin/agent-sync#readme",
  "bugs": {
    "url": "https://github.com/lvxiaoxin/agent-sync/issues"
  },
  "author": "lvxiaoxin",
  "keywords": [
    "agent",
    "sync",
    "copilot",
    "claude",
    "codex",
    "mcp",
    "skills",
    "cli",
    "cross-platform"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0"
  }
}
